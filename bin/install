#!/usr/bin/env bash
# asdf/mise plugin install helper
# Usage:
#   bin/install <version> <install_path>
#   bin/install "" <install_path>   # use default version
# If install_path is not supplied, this script will try common env vars
# and finally fall back to ~/.asdf/installs/manpager/<version>
set -euo pipefail

# ---- Configuration ----
DEFAULT_VERSION="0.0.3"
PLUGIN_NAME="manpager"
GH_REPO="Freed-Wu/manpager"
GITHUB_ARCHIVE_TEMPLATE="https://github.com/${GH_REPO}/archive/refs/tags/%s.tar.gz"

# ---- helpers ----
# shellcheck source=../lib/utils.bash
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/utils.bash"

get_version_from_args_or_env() {
  local arg="${1:-}"
  local v=""

  if [ -n "${arg}" ]; then
    v="${arg}"
  fi

  # Common fallback environment variables
  if [ -z "${v}" ]; then
    v="${MISE_VERSION:-${Mise_VERSION:-${MISE_ARG_VERSION:-${ASDF_INSTALL_VERSION:-${ASDF_VERSION:-}}}}}"
  fi

  if [ -z "${v}" ] && [ -n "${MISE_ARG:-}" ]; then
    case "${MISE_ARG}" in
      *@*) v="${MISE_ARG#*@}" ;;
    esac
  fi

  if [ -z "${v}" ] && [ -n "${arg}" ]; then
    case "${arg}" in
      *@*) v="${arg#*@}" ;;
    esac
  fi

  if [ -z "${v}" ]; then
    v="${DEFAULT_VERSION}"
    info "no version supplied; defaulting to ${v}"
  fi

  printf '%s' "${v}"
}

determine_install_dir() {
  local provided="${1:-}"
  local version="${2:-}"
  local dir=""

  # 1) explicit positional provided by caller
  if [ -n "${provided}" ]; then
    dir="${provided}"
  fi

  # 2) common environment variables used by asdf/mise
  if [ -z "${dir}" ]; then
    dir="${ASDF_INSTALL_DIR:-${ASDF_INSTALL_PATH:-${MISE_INSTALL_DIR:-${MISE_PREFIX:-}}}}"
  fi

  # 3) ASDF_DIR or ASDF_DATA_DIR layout if available
  if [ -z "${dir}" ]; then
    if [ -n "${ASDF_DATA_DIR:-}" ]; then
      dir="${ASDF_DATA_DIR}/installs/${PLUGIN_NAME}/${version}"
    elif [ -n "${ASDF_DIR:-}" ]; then
      dir="${ASDF_DIR}/installs/${PLUGIN_NAME}/${version}"
    fi
  fi

  # 4) MISE common fallback layout
  if [ -z "${dir}" ] && [ -n "${HOME:-}" ]; then
    # prefer mise location if MISE_HOME is present
    if [ -n "${MISE_HOME:-}" ]; then
      dir="${MISE_HOME}/installs/${PLUGIN_NAME}/${version}"
    else
      # final fallback to asdf-like path in home
      dir="${HOME}/.asdf/installs/${PLUGIN_NAME}/${version}"
    fi
  fi

  printf '%s' "${dir}"
}

validate_upstream_tag() {
  local version="$1"
  local url
  url="$(printf "${GITHUB_ARCHIVE_TEMPLATE}" "${version}")"
  info "Checking upstream archive: ${url}"
  if command -v curl >/dev/null 2>&1; then
    if ! curl -fSL --head "${url}" >/dev/null 2>&1; then
      return 1
    fi
  elif command -v wget >/dev/null 2>&1; then
    if ! wget --spider -q "${url}" >/dev/null 2>&1; then
      return 1
    fi
  else
    fail "Neither curl nor wget is available to check upstream."
  fi
  return 0
}

download_archive() {
  local version="$1"
  local dest="$2"
  local url
  url="$(printf "${GITHUB_ARCHIVE_TEMPLATE}" "${version}")"
  info "Downloading ${url} -> ${dest}"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "${url}" -o "${dest}" || return 1
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "${dest}" "${url}" || return 1
  else
    fail "Neither curl nor wget found to download archive"
  fi
}

extract_archive_to_tmp() {
  local archive="$1"
  local destdir="$2"
  mkdir -p "${destdir}"
  tar -xzf "${archive}" -C "${destdir}" || return 1
}

find_extracted_root() {
  local srcdir="$1"
  local root
  root="$(find "${srcdir}" -mindepth 1 -maxdepth 1 -type d | head -n1 || true)"
  printf '%s' "${root}"
}

normalize_install_tree() {
  local src_root="$1"
  local install_dir="$2"

  info "Copying source files to ${install_dir}"
  mkdir -p "${install_dir}"
  cp -R "${src_root}/." "${install_dir}/"

  mkdir -p "${install_dir}/bin"

  local candidate=""
  if [ -f "${install_dir}/manpager" ]; then
    candidate="${install_dir}/manpager"
  elif [ -f "${install_dir}/bin/manpager" ]; then
    candidate="${install_dir}/bin/manpager"
  else
    candidate="$(find "${install_dir}" -maxdepth 3 -type f -name 'manpager' -perm /u+x 2>/dev/null | head -n1 || true)"
  fi

  if [ -z "${candidate}" ]; then
    candidate="$(find "${install_dir}" -maxdepth 3 -type f -name 'manpager' 2>/dev/null | head -n1 || true)"
  fi

  if [ -z "${candidate}" ] && [ -f "${install_dir}/manpager.sh" ]; then
    candidate="${install_dir}/manpager.sh"
  fi

  if [ -n "${candidate}" ]; then
    info "Using candidate executable: ${candidate}"
    chmod +x "${candidate}" || true
    if [ "${candidate}" != "${install_dir}/bin/manpager" ]; then
      cp -f "${candidate}" "${install_dir}/bin/manpager"
    fi
  else
    info "No manpager file found; creating shim"
    create_shim "${install_dir}"
  fi
}

create_shim() {
  local install_dir="$1"
  cat > "${install_dir}/bin/manpager" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root_dir="$(cd "${self_dir}/.." && pwd)"
if [ -x "${root_dir}/manpager" ]; then
  exec "${root_dir}/manpager" "$@"
elif [ -x "${root_dir}/bin/manpager" ] && [ "${root_dir}/bin/manpager" != "${self_dir}/manpager" ]; then
  exec "${root_dir}/bin/manpager" "$@"
else
  echo "manpager executable not found in installation directory." >&2
  exit 1
fi
EOF
  chmod +x "${install_dir}/bin/manpager"
}

write_version_file() {
  local version="$1"
  local install_dir="$2"
  echo "${version}" > "${install_dir}/VERSION"
}

# ---- entrypoint ----
main() {
  local raw_arg_version="${1:-}"
  local raw_arg_install="${2:-}"

  local version
  version="$(get_version_from_args_or_env "${raw_arg_version}")"

  local install_dir
  install_dir="$(determine_install_dir "${raw_arg_install}" "${version}")"

  if [ -z "${install_dir}" ]; then
    fail "install path is required and could not be determined from arguments or environment"
  fi

  info "Installing ${PLUGIN_NAME} version ${version} to ${install_dir}"

  if ! validate_upstream_tag "${version}"; then
    info "Upstream tag ${version} not found. Available tags (via list-all):"
    "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/list-all" >&2 || true
    fail "Upstream tag ${version} not found or unreachable."
  fi

  ensure_cmd mkdir
  ensure_cmd cp
  ensure_cmd tar
  ensure_cmd find

  local tmpdir
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "${tmpdir}"' EXIT

  local archive="${tmpdir}/src.tar.gz"
  if ! download_archive "${version}" "${archive}"; then
    fail "Failed to download archive for ${version}"
  fi

  local extracted_dir="${tmpdir}/src"
  extract_archive_to_tmp "${archive}" "${extracted_dir}"

  local src_root
  src_root="$(find_extracted_root "${extracted_dir}")"
  [ -d "${src_root}" ] || fail "Failed to locate extracted source root."

  normalize_install_tree "${src_root}" "${install_dir}"
  write_version_file "${version}" "${install_dir}"

  info "Installed ${PLUGIN_NAME} ${version} to ${install_dir}"
  info "Hint: run 'asdf reshim ${PLUGIN_NAME}' if using asdf; mise typically handles shims automatically."
}

main "$@"
