#!/usr/bin/env bash
# asdf plugin install helper (ASDF env var style, function-oriented, robust temp handling)
# Called by asdf/mise as: bin/install
# Uses ASDF_INSTALL_VERSION and ASDF_INSTALL_PATH (optional ASDF_DOWNLOAD_PATH)
set -euo pipefail

ASDF_INSTALL_TYPE=${ASDF_INSTALL_TYPE:-version}
TMPDIR=${TMPDIR:-/tmp}

GH_REPO="Freed-Wu/manpager"

# Helpers
fail() {
  echo "ERROR: $*" >&2
  exit 1
}
info() {
  echo "INFO: $*"
}
warn() {
  echo "WARN: $*" >&2
}
require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    fail "Command '$1' not found. Please install it and retry."
  fi
}

# Determine latest tag if ASDF_INSTALL_VERSION is not provided
get_latest_release_version() {
  info "Fetching latest release for ${GH_REPO}"
  # Try releases/latest
  tag="$(curl -fsSL "https://api.github.com/repos/${GH_REPO}/releases/latest" 2>/dev/null | sed -n 's/.*"tag_name":[[:space:]]*"\([^"]*\)".*/\1/p' || true)"
  if [ -n "${tag:-}" ]; then
    echo "${tag}"
    return 0
  fi

  # Fallback to tags list
  tag="$(curl -fsSL "https://api.github.com/repos/${GH_REPO}/tags?per_page=1" 2>/dev/null | sed -n 's/.*"name":[[:space:]]*"\([^"]*\)".*/\1/p' || true)"
  if [ -n "${tag:-}" ]; then
    echo "${tag}"
    return 0
  fi

  warn "Unable to determine latest tag from GitHub API; defaulting to 'latest'"
  echo "latest"
}

get_archive_url() {
  local version="$1"
  echo "https://github.com/${GH_REPO}/archive/refs/tags/${version}.tar.gz"
}

find_src_root() {
  local srcdir="$1"
  find "${srcdir}" -mindepth 1 -maxdepth 1 -type d | head -n1 || true
}

create_shim() {
  local install_dir="$1"
  mkdir -p "${install_dir}/bin"
  cat > "${install_dir}/bin/manpager" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root_dir="$(cd "${self_dir}/.." && pwd)"
# Prefer root-level executable
if [ -x "${root_dir}/manpager" ]; then
  exec "${root_dir}/manpager" "$@"
elif [ -x "${root_dir}/bin/manpager" ] && [ "${root_dir}/bin/manpager" != "${self_dir}/manpager" ]; then
  exec "${root_dir}/bin/manpager" "$@"
else
  echo "manpager executable not found in installation directory." >&2
  exit 1
fi
EOF
  chmod +x "${install_dir}/bin/manpager"
}

detect_and_install_executable() {
  local install_dir="$1"
  local candidate=""

  mkdir -p "${install_dir}/bin"

  if [ -f "${install_dir}/manpager" ]; then
    candidate="${install_dir}/manpager"
  elif [ -f "${install_dir}/bin/manpager" ]; then
    candidate="${install_dir}/bin/manpager"
  else
    candidate="$(find "${install_dir}" -maxdepth 2 -type f -name 'manpager' | head -n1 || true)"
  fi

  if [ -z "${candidate}" ] && [ -f "${install_dir}/manpager.sh" ]; then
    candidate="${install_dir}/manpager.sh"
  fi

  if [ -n "${candidate}" ]; then
    chmod +x "${candidate}" || true
    if [ "${candidate}" != "${install_dir}/bin/manpager" ]; then
      cp -f "${candidate}" "${install_dir}/bin/manpager"
    fi
  else
    create_shim "${install_dir}"
  fi
}

install_manpager() {
  local install_type="$1"
  local version="$2"
  local install_path="$3"

  require_cmd curl
  require_cmd tar
  require_cmd mkdir
  require_cmd cp
  require_cmd find

  # Safe tmp dir variable (avoid 'unbound variable' in traps)
  tmp_download_dir=""

  cleanup() {
    # Use parameter expansion to avoid unbound var errors under 'set -u'
    if [ -n "${tmp_download_dir:-}" ] && [ -d "${tmp_download_dir:-}" ]; then
      rm -rf "${tmp_download_dir}"
    fi
  }
  trap cleanup EXIT

  # Decide where to download/extract
  if [ -n "${ASDF_DOWNLOAD_PATH:-}" ]; then
    mkdir -p "${ASDF_DOWNLOAD_PATH}"
    tmp_download_dir="${ASDF_DOWNLOAD_PATH}"
  elif [ -z "${TMPDIR:-}" ]; then
    tmp_download_dir="$(mktemp -d -t manpager_XXXXXX)"
  else
    # If TMPDIR is a path to a directory, use it; otherwise create a temp dir inside it
    if [ -d "${TMPDIR}" ]; then
      tmp_download_dir="$(mktemp -d -p "${TMPDIR}" manpager_XXXXXX)"
    else
      tmp_download_dir="$(mktemp -d -t manpager_XXXXXX)"
    fi
  fi

  mkdir -p "${install_path}"
  mkdir -p "${install_path}/bin"

  local download_url
  download_url="$(get_archive_url "${version}")"

  info "Downloading ${GH_REPO}@${version} from ${download_url}"
  local archive_path="${tmp_download_dir}/src.tar.gz"
  curl -fsSL "${download_url}" -o "${archive_path}" || fail "Failed to download ${download_url}"

  info "Extracting archive"
  local src_extract="${tmp_download_dir}/src"
  mkdir -p "${src_extract}"
  tar -xzf "${archive_path}" -C "${src_extract}" || fail "Failed to extract archive"

  local src_root
  src_root="$(find_src_root "${src_extract}")"
  [ -d "${src_root}" ] || fail "Failed to locate source root directory."

  info "Copying source files to ${install_path}"
  cp -R "${src_root}/." "${install_path}/"

  detect_and_install_executable "${install_path}"

  # Ensure list-all and install are executable if present (avoid needing manual chmod)
  for script_name in list-all install; do
    # check top-level and bin/
    if [ -f "${install_path}/${script_name}" ]; then
      chmod +x "${install_path}/${script_name}" || true
    fi
    if [ -f "${install_path}/bin/${script_name}" ]; then
      chmod +x "${install_path}/bin/${script_name}" || true
    fi
    # also search up to depth 2 for any matching files and chmod them
    find "${install_path}" -maxdepth 2 -type f -name "${script_name}" -exec chmod +x {} \; || true
  done

  echo "${version}" > "${install_path}/VERSION"

  info "Installed manpager ${version} to ${install_path}"
  info "Hint: run 'asdf reshim manpager' if using asdf; mise typically handles shims automatically"
}

# Entrypoint behavior (ASDF style)
# If ASDF_INSTALL_VERSION not provided, attempt to fetch latest. If still empty, error.
if [ -z "${ASDF_INSTALL_VERSION:-}" ]; then
  ASDF_INSTALL_VERSION="$(get_latest_release_version)"
fi

if [ -z "${ASDF_INSTALL_VERSION:-}" ]; then
  fail "Missing ASDF_INSTALL_VERSION"
fi

if [ -z "${ASDF_INSTALL_PATH:-}" ]; then
  fail "Missing ASDF_INSTALL_PATH"
fi

# Only run installer when script executed directly
if [[ "${BASH_SOURCE[0]}" = "$0" ]]; then
  install_manpager "${ASDF_INSTALL_TYPE}" "${ASDF_INSTALL_VERSION}" "${ASDF_INSTALL_PATH}"
fi
